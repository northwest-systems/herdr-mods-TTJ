{
  "id": "ttj-bottom",
  "type": "column",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "herdr-workspace",
      "type": "row",
      "children": [
        {
          "id": "workspace-sidebar",
          "type": "column",
          "size": {
            "px": 180
          },
          "children": [
            {
              "id": "workspace-spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "workspace-agents",
              "type": "block",
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "herdr-work",
          "type": "column",
          "children": [
            {
              "id": "workspace-tabs",
              "type": "row",
              "size": {
                "px": 36
              },
              "children": [
                { "id": "workspace-tab-bar", "type": "block", "content": { "mod": "tabs" } },
                { "id": "ttj-toggle", "type": "block", "size": { "px": 104 }, "content": { "mod": "ttj", "props": { "launcher": true, "panel": "ttj-panel" } } }
              ]
            },
            {
              "id": "workspace-panes",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "lone": true,
                  "header": {
                    "content": { "mod": "ttj", "props": { "screen": "pane-header" } },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ttj-panel",
      "type": "block",
      "hidden": true,
      "min": 160,
      "content": {
        "mod": "ttj",
        "props": { "panel": "ttj-panel" }
      },
      "size": {
        "px": 320
      }
    }
  ]
}
